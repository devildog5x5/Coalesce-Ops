ErrorDocument 404 /404.html
DirectoryIndex index.html

AddType application/manifest+json .webmanifest
AddType text/plain .txt

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Never serve source, operator files, or release archives from the live site.
<IfModule mod_authz_core.c>
  <FilesMatch "(?i)\.(7z|bak|bat|cmd|env|gz|ini|json|key|log|md|pem|ps1|py|pyc|pyo|sh|sql|tar|tgz|toml|ya?ml|zip)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(VERSION|\.gitignore|\.gitattributes)$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(?i)\.(7z|bak|bat|cmd|env|gz|ini|json|key|log|md|pem|ps1|py|pyc|pyo|sh|sql|tar|tgz|toml|ya?ml|zip)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(VERSION|\.gitignore|\.gitattributes)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On

  # One public address: https://coalesceops.com
  RewriteCond %{HTTP_HOST} ^www\.coalesceops\.com$ [NC]
  RewriteRule ^ https://coalesceops.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^coalesceops\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://coalesceops.com%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.(html|php)$ https://coalesceops.com/ [L,R=301]

  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://coalesceops.com/$1 [L,R=301]

  RewriteRule "(?:^|/)\.git(?:/|$)" - [F,L]
  RewriteRule "(?:^|/)\.cursor(?:/|$)" - [F,L]
  RewriteRule "(?:^|/)(?:includes|build|installers|__pycache__|node_modules)(?:/|$)" - [F,L]
</IfModule>
